# =====================================================================
# Frontend Environment Variables (Vite)
# =====================================================================
# Supabase Configuration (Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Python FastAPI Gateway URL (React uses this to communicate with the SMS service)
VITE_BACKEND_API_URL=http://localhost:8000

# =====================================================================
# Backend Environment Variables (Python FastAPI / sms_service.py)
# Put these in your local .env or system environment variables
# CRITICAL: Never prefix backend secrets with VITE_ to prevent leakage
# =====================================================================
# Fast2SMS API Key (Obtain free/wallet key from https://www.fast2sms.com > Dev API)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Default recipient mobile (10-digit Indian phone number without +91)
ALERT_TARGET_PHONE=9876543210

# Backend Host & Port
API_HOST=0.0.0.0
API_PORT=8000
